vertexlitgeneric
{

$basetexture "models\survivors\TeenAngst/zoey_head"
$compress "models\survivors\TeenAngst/zoey_head_compress"
$stretch "models\survivors\TeenAngst/zoey_head_compress"
$bumpmap "models\survivors\TeenAngst/zoey_head_normal"
$halflambert 1
"$phong" 			"1"
"$phongboost" 			"9"
$phongfresnelranges 		"[.5 .1 2]"
$phongexponenttexture       		"models\survivors\ninjamai\cheerleader\Body_Wet_gls"
$phongalbedotint 			1
"$envmap" 			"env_cubemap"
$normalmapalphaenvmapmask	1
"$envmaptint" 			"[.05 .05 .05]"	
$envmapfresnel 			1
$envmapFresnelMinMaxExp		 "[0 .8 .3]"
"$rimlight" 			"1" 
"$rimlightexponent" 			"1"
"$rimlightboost" 			"1.6"

$nodecal 1
$ambientocclusion 1
}
